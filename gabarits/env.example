# Fichier de secrets du pont (créé par `venice-setup login`, mode 600). NE JAMAIS le committer.
VENICE_CLERK_CLIENT=<valeur du cookie __client de venice.ai>
VENICE_PONT_CLE=<clé locale générée, que les clients présentent au pont>
# Facultatif : clé de l'API officielle (api.venice.ai, FACTURÉE à l'usage) pour les modèles api/… et les outils natifs.
# Sans VENICE_CLERK_CLIENT, le pont tourne en mode « API seule ».
# VENICE_API_KEY=<clé API Venice>
# Réglages facultatifs (variables d'environnement du service) :
# VENICE_PONT_ECOUTE=127.0.0.1:8700
# VENICE_PONT_MAX_PAR_MIN=20
# VENICE_PONT_GRATUITS=qwen-3-8-27b,venice-uncensored-1-2,...
# VENICE_PONT_AUTORISER_PAYANTS=1   # DÉBITE des crédits : déconseillé
# VENICE_PONT_ALIAS=claude-*haiku*=qwen-3-8-27b,claude-*=kimi-k2-5,gpt-*=kimi-k2-5   # noms des clients de code -> modèles Venice
# VENICE_PONT_CONTEXTE_CHAT=36000   # garde de contexte du chat classique (jetons estimés) ; 0 la coupe
# VENICE_PONT_ELAGAGE=1             # 0 : refuser (400 context_length_exceeded) au lieu d'élaguer
