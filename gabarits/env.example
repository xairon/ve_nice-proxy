# Fichier de secrets du pont (créé par `venice-setup login`, mode 600). NE JAMAIS le committer.
VENICE_CLERK_CLIENT=<valeur du cookie __client de venice.ai>
VENICE_PONT_CLE=<clé locale générée, que les clients présentent au pont>
# Réglages facultatifs (variables d'environnement du service) :
# VENICE_PONT_ECOUTE=127.0.0.1:8700
# VENICE_PONT_MAX_PAR_MIN=20
# VENICE_PONT_GRATUITS=qwen-3-8-27b,venice-uncensored-1-2,...
# VENICE_PONT_AUTORISER_PAYANTS=1   # DÉBITE des crédits : déconseillé
